{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "discord-shinya",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NIGHT_COORDINATOR",
        "class_name": "NightCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["NightCoordinator"]
    }
  ],
  "triggers": {
    "crons": [
      "0 15,18,23 * * *"
    ]
  }
}
